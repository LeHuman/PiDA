[Unit]
Description=Pi Action API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pida
Environment=PYTHONPATH=/opt/pida/src
# Service settings (port, bind, workers, threads) live in the `service:`
# section of /home/pi/.pida/pida.yaml; scripts/serve.py reads them and
# execs gunicorn. Edit pida.yaml, then: systemctl restart pi-api.
# (postinst rewrites /home/pi to the resolved home for non-pi installs.)
ExecStart=/home/pi/.pida/.venv/bin/python /opt/pida/scripts/serve.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target