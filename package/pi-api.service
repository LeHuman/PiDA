[Unit]
Description=Pi Action API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pida
Environment=PYTHONPATH=/opt/pida/src
# Service config (port, bind, workers, threads) is user-owned:
# /home/pi/.pida/env. Edit it, then systemctl restart pi-api.
# (postinst rewrites /home/pi to the resolved home for non-pi installs.)
EnvironmentFile=/home/pi/.pida/env
ExecStart=/home/pi/.pida/.venv/bin/gunicorn -w ${PIDA_WORKERS} --threads ${PIDA_THREADS} -b ${PIDA_BIND}:${PIDA_PORT} server:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
